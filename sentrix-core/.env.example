# Sentrix Core Environment Configuration

# Server Port
PORT=4000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_DATABASE=sentrix

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Public Server URL (used for agent zero-touch updates & webhooks)
BACKEND_URL=https://localhost:4000

# Administrator Default Credentials (for provisioning)
SENTRIX_ADMIN_USERNAME=Administrator
SENTRIX_ADMIN_PASSWORD=SentrixLab2026!

# Optional Network Discovery Subnet Override
# DISCOVERY_SUBNET=192.168.1
